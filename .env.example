# Keep "demo" for the existing prototype. Set to "production" to enable real authentication.
NEXT_PUBLIC_APP_MODE=demo
# Exact backend API origin. In Vercel this is the Render service origin and is inlined at build
# time, so redeploy after changing it. The client preserves that deployed hostname; only local
# localhost/127.0.0.1 pairs are reconciled to keep SameSite refresh cookies on one loopback host.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Optional explicit release override. Leave blank to fall back to Vercel commit SHA when present.
NEXT_PUBLIC_SENTRY_RELEASE=
# Only required when enabling source-map upload during builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=